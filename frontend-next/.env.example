# Copy this file to `frontend-next/.env.local` for LOCAL development.
# These values are PUBLIC identifiers, not secrets. Never put JWT_SECRET_KEY,
# OPENAI_API_KEY, SMTP_PASSWORD, database URLs or BYOK keys here.

# FastAPI base URL. The browser never calls it directly: Next.js route handlers
# proxy same-origin requests and attach the HttpOnly JWT cookie as a Bearer token.
# NEXT_PUBLIC_* is compiled into client JavaScript at BUILD time: in Docker,
# pass it as a build ARG and REBUILD when the value changes.
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000/api/v1

# Optional explicit SERVER-ONLY override used by the BFF. If omitted,
# NEXT_PUBLIC_API_BASE_URL is used. In production Compose this is
# http://backend:8000/api/v1 (internal Docker network) and is never baked into
# client JavaScript.
# API_BASE_URL=http://localhost:8000/api/v1

# Google OAuth2 public client ID. Leave empty to hide Google sign-in; the button
# is offered only when the backend reports GOOGLE_OAUTH_ENABLED=true and a valid
# client ID is configured. Same value as backend GOOGLE_OAUTH_CLIENT_ID.
# Must be set as a Docker build ARG as well for the browser bundle.
NEXT_PUBLIC_GOOGLE_CLIENT_ID=
