# Copy this file to `.env` in the PROJECT ROOT and replace EVERY placeholder.
# Docker Compose reads `.env` automatically. Never commit a real `.env`.
#
# This file now serves the PRODUCTION stack in docker-compose.yml.
# docker-compose.db.yml (local PostgreSQL only) is preserved unchanged. If you
# run the backend directly on the host against that DB-only compose file,
# override DATABASE_URL with host `localhost` instead of `postgres`.
#
# Data safety: production reuses the existing external volume
# smartquerysystem_smartquery_postgres_data. Never delete it or use `down -v`.
#
# Strict production validation: the backend refuses to start with DEBUG=true,
# placeholder/known-development JWT or Fernet secrets, placeholder database
# credentials, localhost external DB hosts, unencrypted external DB URLs,
# wildcard/localhost CORS, or placeholder sender/provider identities. Replace
# every REPLACE_WITH_* value before starting in production.

# ---------------------------------------------------------------------------
# Compose / images
# ---------------------------------------------------------------------------
# Pin a release tag (for example v1.0.0) so rollback is a tag change.
IMAGE_TAG=latest
FRONTEND_PORT=3000
ENVIRONMENT=production
DEBUG=false
# Entrypoint runs `alembic upgrade head` by default. Set false only when
# migrations are run as an explicit one-off in scaled deployments.
RUN_MIGRATIONS=true

# ---------------------------------------------------------------------------
# PostgreSQL (must match the credentials already initialized in the volume)
# ---------------------------------------------------------------------------
POSTGRES_DB=smartquery_db
POSTGRES_USER=smartquery
# Generate: python -c "import secrets; print(secrets.token_urlsafe(24))"
POSTGRES_PASSWORD=REPLACE_WITH_GENERATED_DB_PASSWORD
# Container-network URL used by the backend service (host is `postgres`).
# If the password contains reserved URL characters, percent-encode it
# (urllib.parse.quote_plus). Keep this identical to POSTGRES_PASSWORD.
# The internal `postgres` host is the only production exception to the TLS
# requirement. For managed PostgreSQL, use the provider host and append
# `?sslmode=require` (or verify-full) to DATABASE_URL.
DATABASE_URL=postgresql+psycopg://smartquery:REPLACE_WITH_GENERATED_DB_PASSWORD@postgres:5432/smartquery_db
TEST_DATABASE_URL=
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=10
DB_POOL_TIMEOUT=30
DB_ECHO=false

# ---------------------------------------------------------------------------
# Public URLs / CORS
# ---------------------------------------------------------------------------
# PUBLIC value (not a secret); compiled into frontend JS at BUILD time.
# Replace with your real HTTPS domain before building the frontend image.
NEXT_PUBLIC_API_BASE_URL=https://smartquery.example.edu/api/v1
# SERVER-ONLY BFF target; uses the internal Docker network, never the browser.
API_BASE_URL=http://backend:8000/api/v1
# Public OAuth client ID; same value as GOOGLE_OAUTH_CLIENT_ID below.
NEXT_PUBLIC_GOOGLE_CLIENT_ID=REPLACE_WITH_GOOGLE_OAUTH_CLIENT_ID
BACKEND_CORS_ORIGINS=["https://smartquery.example.edu"]
API_V1_PREFIX=/api/v1
PROJECT_NAME=Smart Query Routing System
VERSION=1.0.0

# ---------------------------------------------------------------------------
# Authentication (PRODUCTION REQUIREMENT)
# ---------------------------------------------------------------------------
# Generate: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET_KEY=REPLACE_WITH_LONG_RANDOM_JWT_SECRET
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
MIN_PASSWORD_LENGTH=12

# ---------------------------------------------------------------------------
# BYOK / AI policy (PRODUCTION REQUIREMENTS)
# ---------------------------------------------------------------------------
# Fernet key used to encrypt each user's personal OpenAI key at rest.
# Generate EXACTLY with:
# python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# Store the result in a secret manager; losing it makes stored keys unrecoverable.
BYOK_ENCRYPTION_KEY=REPLACE_WITH_FERNET_KEY
# MUST be false in production (the backend refuses to start otherwise).
ALLOW_GLOBAL_OPENAI_FALLBACK=false
# Leave the global key EMPTY under the production BYOK policy: users provide
# their own keys. Any key here is server-side only and never sent to browsers.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENAI_TIMEOUT_SECONDS=20
AI_MAX_INPUT_TOKENS=3000
AI_MAX_OUTPUT_TOKENS=800
AI_LLM_ATTEMPTS=2
AI_GRAPH_TIMEOUT_SECONDS=60
AI_GRAPH_RECURSION_LIMIT=12
AI_MIN_CONFIDENCE=0.35
AI_KNOWLEDGE_FILE=
AI_RATE_LIMIT_PER_MINUTE=20

# ---------------------------------------------------------------------------
# SLA / escalation
# ---------------------------------------------------------------------------
SLA_HOURS=24
ESCALATION_SWEEP_MINUTES=60
# Optional shared secret for serverless cron/scheduler trigger:
# POST /api/v1/tickets/escalation/sweep with X-Cron-Secret header.
# Leave empty to disable the cron endpoint.
ESCALATION_CRON_SECRET=

# ---------------------------------------------------------------------------
# SMTP email notifications (provider account required for live delivery)
# ---------------------------------------------------------------------------
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=REPLACE_WITH_SMTP_USERNAME
SMTP_PASSWORD=REPLACE_WITH_SMTP_PASSWORD
SMTP_USE_TLS=true
SMTP_USE_SSL=false
SMTP_TIMEOUT_SECONDS=10
SMTP_ATTEMPTS=3
# Must use your real verified sender domain; example domains are rejected in production.
MAIL_FROM=noreply@REPLACE_WITH_REAL_DOMAIN
EMAIL_NOTIFICATIONS_ENABLED=true

# ---------------------------------------------------------------------------
# Meta WhatsApp Cloud API (provider account required for live delivery)
# ---------------------------------------------------------------------------
WHATSAPP_ENABLED=false
WHATSAPP_ACCESS_TOKEN=REPLACE_WITH_META_SYSTEM_USER_TOKEN
WHATSAPP_PHONE_NUMBER_ID=REPLACE_WITH_WHATSAPP_PHONE_NUMBER_ID
# Generate: python -c "import secrets; print(secrets.token_urlsafe(32))"
WHATSAPP_VERIFY_TOKEN=REPLACE_WITH_WHATSAPP_VERIFY_TOKEN
WHATSAPP_API_VERSION=v21.0

# ---------------------------------------------------------------------------
# Inbound integrations / Google OAuth2
# ---------------------------------------------------------------------------
# Shared secret for protected inbound intake webhooks (server-side only).
# Leave empty if inbound webhooks are not used. If set, generate with:
# python -c "import secrets; print(secrets.token_urlsafe(32))"
INTAKE_WEBHOOK_TOKEN=
GOOGLE_OAUTH_ENABLED=false
GOOGLE_OAUTH_CLIENT_ID=REPLACE_WITH_GOOGLE_OAUTH_CLIENT_ID

# ---------------------------------------------------------------------------
# Uploads and abuse controls
# ---------------------------------------------------------------------------
# 5 MiB default; maximum accepted by settings is 50 MiB.
MAX_UPLOAD_BYTES=5242880
ALLOWED_UPLOAD_TYPES=pdf,txt,md
# Ticket attachments are stored outside the web root and database. In Docker
# this defaults to the persistent /app/var/attachments named volume.
ATTACHMENT_STORAGE_DIR=/app/var/attachments
# Optional malware scan hook. When enabled, uploads fail closed.
# Example command (ClamAV): clamscan --no-summary {file}
MALWARE_SCAN_ENABLED=false
MALWARE_SCAN_COMMAND=
MALWARE_SCAN_TIMEOUT_SECONDS=20
