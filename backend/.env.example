# Copy this file to `backend/.env` for LOCAL (non-container) development.
# Never commit a real .env file or real credentials. The production Docker
# image does NOT copy this file: production values are injected by
# docker-compose.yml from the project-root .env / your secret manager.
# Copying a local .env into a production image or repository is forbidden.
#
# Local development may use the placeholders below because ENVIRONMENT=development.
# Production validation additionally rejects DEBUG=true, placeholder JWT/Fernet
# values, placeholder DB credentials, localhost external DB hosts, unencrypted
# external DB URLs, wildcard/localhost CORS, and placeholder provider identities.

# ---------------------------------------------------------------------------
# Application
# ---------------------------------------------------------------------------
PROJECT_NAME="Smart Query Routing System"
VERSION="1.0.0"
API_V1_PREFIX="/api/v1"
DEBUG=false
# development | staging | production.
# Production requires JWT_SECRET_KEY and BYOK_ENCRYPTION_KEY, and forbids
# ALLOW_GLOBAL_OPENAI_FALLBACK=true (enforced at application startup).
ENVIRONMENT="development"

# Comma-separated or JSON list of allowed CORS origins.
BACKEND_CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173"]

# ---------------------------------------------------------------------------
# Database (local dev: host PostgreSQL from docker-compose.db.yml)
# ---------------------------------------------------------------------------
# In containers this host is `postgres`, not localhost.
DATABASE_URL="postgresql+psycopg://smartquery:change-me-local-dev@localhost:5432/smartquery_db"
TEST_DATABASE_URL=""
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=10
DB_POOL_TIMEOUT=30
DB_ECHO=false

# ---------------------------------------------------------------------------
# Authentication (Phase 4)
# ---------------------------------------------------------------------------
# Generate: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET_KEY="replace-with-a-long-random-secret"
JWT_ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=60
MIN_PASSWORD_LENGTH=12

# First local admin (dev-only CLI). Leave blank to use a hidden interactive prompt.
# Never commit real values: python -m app.cli.provision_admin --email admin@university.edu
ADMIN_EMAIL=""
ADMIN_PASSWORD=""

# ---------------------------------------------------------------------------
# AI provider (Phase 6) - server-side only, never exposed to the frontend
# ---------------------------------------------------------------------------
# Under the production BYOK policy leave this empty and let users add their
# own keys. ALLOW_GLOBAL_OPENAI_FALLBACK must be false in production.
OPENAI_API_KEY=""
OPENAI_MODEL="gpt-4o-mini"
OPENAI_TIMEOUT_SECONDS=20
AI_MAX_INPUT_TOKENS=3000
AI_MAX_OUTPUT_TOKENS=800
AI_LLM_ATTEMPTS=2
AI_GRAPH_TIMEOUT_SECONDS=60
AI_GRAPH_RECURSION_LIMIT=12
AI_MIN_CONFIDENCE=0.35
AI_KNOWLEDGE_FILE=""

# ---------------------------------------------------------------------------
# BYOK encryption and AI abuse controls (Phase 7)
# ---------------------------------------------------------------------------
# Fernet key used to encrypt each user's personal OpenAI key at rest.
# Generate EXACTLY with:
# python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# REQUIRED when ENVIRONMENT=production. Store in a secret manager; losing this
# key makes previously stored personal keys unrecoverable. To rotate, use the
# documented CLI with BYOK_ROTATION_OLD_KEY and BYOK_ROTATION_NEW_KEY supplied by
# the operator; never paste either key into this file or a shell argument.
BYOK_ENCRYPTION_KEY="REPLACE_WITH_FERNET_KEY"
ALLOW_GLOBAL_OPENAI_FALLBACK=false
AI_RATE_LIMIT_PER_MINUTE=20

# ---------------------------------------------------------------------------
# SLA / deterministic escalation (Phase 7)
# ---------------------------------------------------------------------------
SLA_HOURS=24
ESCALATION_SWEEP_MINUTES=60
# Optional shared secret for serverless cron/scheduler trigger:
# POST /api/v1/tickets/escalation/sweep with X-Cron-Secret header.
# Generate: python -c "import secrets; print(secrets.token_urlsafe(32))"
ESCALATION_CRON_SECRET=""

# ---------------------------------------------------------------------------
# SMTP email notifications (Phase 7)
# ---------------------------------------------------------------------------
SMTP_HOST="smtp.example.com"
SMTP_PORT=587
SMTP_USER="your-smtp-username"
SMTP_PASSWORD="your-smtp-password"
SMTP_USE_TLS=true
SMTP_USE_SSL=false
SMTP_TIMEOUT_SECONDS=10
SMTP_ATTEMPTS=3
MAIL_FROM="noreply@example.com"
EMAIL_NOTIFICATIONS_ENABLED=true

# ---------------------------------------------------------------------------
# Meta WhatsApp Cloud API (Phase 7) - tokens stay server-side
# ---------------------------------------------------------------------------
WHATSAPP_ENABLED=false
WHATSAPP_ACCESS_TOKEN="REPLACE_WITH_META_SYSTEM_USER_TOKEN"
WHATSAPP_PHONE_NUMBER_ID="REPLACE_WITH_WHATSAPP_PHONE_NUMBER_ID"
# Generate: python -c "import secrets; print(secrets.token_urlsafe(32))"
WHATSAPP_VERIFY_TOKEN="REPLACE_WITH_WHATSAPP_VERIFY_TOKEN"
WHATSAPP_API_VERSION="v21.0"

# ---------------------------------------------------------------------------
# Inbound intake + Google OAuth2 (Phase 7)
# ---------------------------------------------------------------------------
# Shared secret for protected inbound email/webhook intake adapters.
# Generate: python -c "import secrets; print(secrets.token_urlsafe(32))"
INTAKE_WEBHOOK_TOKEN="REPLACE_WITH_INTAKE_WEBHOOK_TOKEN"
GOOGLE_OAUTH_CLIENT_ID="REPLACE_WITH_GOOGLE_OAUTH_CLIENT_ID"
GOOGLE_OAUTH_ENABLED=false

# ---------------------------------------------------------------------------
# Uploads (knowledge documents / ticket attachments)
# ---------------------------------------------------------------------------
MAX_UPLOAD_BYTES=5242880
ALLOWED_UPLOAD_TYPES="pdf,txt,md"
# Ticket attachment bytes are written outside the web root and the database.
# Local default when blank: <backend working directory>/var/attachments.
ATTACHMENT_STORAGE_DIR=""
# Optional malware scan hook. When enabled, uploads fail closed.
# Example command (ClamAV): clamscan --no-summary {file}
MALWARE_SCAN_ENABLED=false
MALWARE_SCAN_COMMAND=""
MALWARE_SCAN_TIMEOUT_SECONDS=20
